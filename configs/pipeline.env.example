# Copy to a file outside the repository, edit, then pass its absolute path.
# This is trusted Bash code. Use absolute paths; do not commit private paths/keys.
CORE_PYTHON=python
CELLPOSE_PYTHON=python
CP_PYTHON=python
DP_PYTHON=python
CP_EXECUTABLE=cellprofiler
RUN_ROOT=/absolute/path/to/new_run
SITE_MANIFEST=/absolute/path/to/sites.csv
CELLPOSE_WEIGHTS=/absolute/path/to/cpsam
DP_WEIGHTS=/absolute/path/to/Cell_Painting_CNN_v1.hdf5
USE_GPU=0
# Optional: existing, channel-annotated HDF5 instead of stage 2 output.
CROPS_H5=
# Stage 5 requires the full training input layout, including metadata and expression.
PROJECT_ROOT=/absolute/path/to/prepared_training_inputs
TRAIN_PREFLIGHT=1
TRAIN_SEED=43
# Stage 6: prepared condition-level embeddings, ordered IDs, and explicit links.
QUERY_FEATURES=/absolute/path/to/query.npy
GALLERY_FEATURES=/absolute/path/to/gallery.npy
QUERY_IDS=/absolute/path/to/query_ids.csv
GALLERY_IDS=/absolute/path/to/gallery_ids.csv
POSITIVE_PAIRS=/absolute/path/to/positive_pairs.csv
EXCLUDED_PAIRS=
# Optional task-based mode: select rows automatically from ID-indexed embedding pools.
# TASK_DIR=/absolute/path/BioMoAX/manifests/tasks/within_u2os
TASK_DIR=
QUERY_POOL=
QUERY_POOL_IDS=
GALLERY_POOL=
GALLERY_POOL_IDS=
